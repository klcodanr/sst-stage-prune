{
  "name": "sst-stage-prune",
  "version": "1.0.1",
  "description": "CLI to prune stale SST stages",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "files": [
    "src"
  ],
  "bin": {
    "sst-stage-prune": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe"
  },
  "keywords": [
    "sst",
    "pull request"
  ],
  "author": "klcodanr",
  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/klcodanr/sst-stage-prune"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "vitest": "^4.1.10",
    "yocto-spinner": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@vitest/coverage-v8": "^4.1.10",
    "semantic-release": "^25.0.8"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "packageManager": "npm@11.13.0"
}